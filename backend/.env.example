# 此本地 Demo 无需 JWT、云端账号配置。
# 服务端口可选；未设置时 main.py 使用 8000。
_BYTEFAAS_RUNTIME_PORT=8000

# ---------------------------------------------------------------------------
# DeepSeek 模型配置
#
# 未配置 DEEPSEEK_API_KEY 时，生成功能会自动回退到本地规则生成器，
# 应用仍可正常使用，只是生成的 AppSpec 质量较差。
# ---------------------------------------------------------------------------

# 必填。在 https://platform.deepseek.com/api_keys 申请，形如 sk-xxxxxxxx
DEEPSEEK_API_KEY=

# 可选。默认 https://api.deepseek.com
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选。默认 deepseek-flash（以 GET /models 的实际返回为准）
# 该账号下可用：deepseek-flash（快，适合生成 AppSpec）、deepseek-v4-pro（更强，更慢）
# 注意：官方文档里写的 deepseek-v4-flash 与实际模型名不一致，请用 deepseek-flash。
# 旧名 deepseek-chat / deepseek-reasoner 已于 2026/07/24 废弃，不要再用。
# DEEPSEEK_MODEL=deepseek-flash

# 可选。思考模式开关，默认 disabled。
# 必须保持 disabled：开启思考后推理内容会先占满输出额度，正文会变成空字符串。
# 取值：disabled / enabled / auto（auto 表示交给服务端默认，通常是 enabled）。
# DEEPSEEK_THINKING=disabled

# 可选。单次请求超时秒数，默认 60
# DEEPSEEK_TIMEOUT=60

# 可选。仅当需要经过代理访问 DeepSeek 时设置。
# 代码默认依次尝试：显式代理 -> 系统 HTTP_PROXY/HTTPS_PROXY -> 直连。
# DEEPSEEK_PROXY=http://127.0.0.1:7890
